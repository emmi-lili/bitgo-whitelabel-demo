# ─────────────────────────────────────────────────────────────────────────────
# Bitgo Whitelabel — Spike Fase 0 (código desechable)
# Copiá este archivo a spike/.env y completá cada valor.
# Uso:  cd spike && cp .env.example .env && node --env-file=.env spike.mjs
# NINGUNO de estos valores debe terminar nunca en el frontend.
# ─────────────────────────────────────────────────────────────────────────────

# Access token de BitGo testnet.
#   Dónde: app.bitgo-test.com → (arriba a la derecha, tu cuenta) → Developer
#   Options / Access Tokens → "Add Access Token". Scope: enterprise, wallet
#   view + spend. Copialo UNA vez, no se vuelve a mostrar.
BITGO_ACCESS_TOKEN=v2x4f723b4a9ffc5f2c5a25a49bc96c82a6dd6c16b64479d5a28215102833a396dd


# Enterprise ID (el principal, el que ya tenés).
#   Dónde: app.bitgo-test.com → Settings del enterprise → el ID está en la URL
#   (/enterprise/<ESTE_ID>/...) o en Enterprise Settings. Empieza distinto a
#   un walletId; es el contenedor de tu Go Account A.
BITGO_ENTERPRISE_ID=68adbfadb4621a6b825871d3114b3477

# Go Account A: la que YA tenés creada. Es el origen de la transferencia.
#   Dónde: app.bitgo-test.com → tu Go Account → el walletId está en la URL o
#   en los detalles de la cuenta. O corré el spike sin esto: el paso 1 lista
#   todas tus Go Accounts (GET /api/v2/ofc/wallet) e imprime sus IDs.
GO_ACCOUNT_A_ID=68adbfcf7b1235c6d0d8b5dad19c88d8

# Go Account B: dejalo VACÍO en la primera corrida.
#   El spike intenta CREARLA (ese es el experimento). Si la crea, imprime su
#   ID; pegalo acá para las corridas siguientes y así no crea una cada vez.
GO_ACCOUNT_B_ID=

# Wallet passphrase de la Go Account A.
#   Es la passphrase con la que creaste/desbloqueás la wallet en BitGo. Se usa
#   para (a) firmar el payload en Express y (b) crear la Go Account B.
#   NUNCA va al navegador. Solo la ve este spike y, más adelante, el BFF.
WALLET_PASSPHRASE=

# passcodeEncryptionCode para crear la Go Account B.
#   Es el código con el que BitGo encripta la passphrase para recuperación
#   (KRS). Elegí uno y guardalo; si perdés passphrase + este código, no hay
#   recuperación. Podés reusar el mismo string que uses de passphrase-recovery.
#   TODO(verify): semántica exacta en
#   https://developers.bitgo.com/docs/crypto-as-a-service-go-accounts
WALLET_PASSCODE_ENCRYPTION_CODE=

# Endpoints. Estos NO se tocan salvo que sepas por qué.
BITGO_API_BASE=https://app.bitgo-test.com
BITGO_EXPRESS_URL=http://localhost:3080

# Activo y monto del test. ofctusd = USD dentro de un Go Account, testnet.
# El monto va en BASE UNITS. No sabemos todavía la escala real (es una de las
# cosas que el spike te reporta): 100 base units es seguro y chico. Ajustá si
# el build se queja de mínimo.
SPIKE_COIN=ofctusd
SPIKE_AMOUNT_BASE=100
