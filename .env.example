# Bitgo Whitelabel — variables del BFF (server-side, NUNCA al navegador).
# Copiá a .env.local para desarrollo.

BITGO_ACCESS_TOKEN=
BITGO_ENTERPRISE_ID=
BITGO_API_BASE=https://app.bitgo-test.com
BITGO_EXPRESS_URL=http://localhost:3080

# Go Accounts confirmadas en el spike (Fase 0).
GO_ACCOUNT_A_ID=
GO_ACCOUNT_B_ID=

# Wallet nativa de Solana testnet (coin `tsol`). Su saldo on-chain se muestra en
# Cuenta junto a los balances OFC. Opcional: si queda vacía no se consulta.
TSOL_WALLET_ID=

# Passphrase de la wallet (solo la usa el BFF para firmar vía Express).
WALLET_PASSPHRASE=
